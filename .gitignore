# --- Secrets & local config ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Local databases / scratch ---
*.db
*.sqlite3

# Local file drops. Nothing in the app writes here any more (uploads go to
# S3/MinIO), but a stray dir used to be created at import time — keep it out.
uploads/
backend/uploads/

# --- Node / frontend ---
node_modules/
dist/
.vite/
npm-debug.log*

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Lambda zip, rebuilt by archive_file on every plan.
infrastructure/terraform/.build/

# .terraform.lock.hcl is deliberately NOT ignored — it pins provider versions so
# CI and every operator resolve the same ones. Commit it.

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
