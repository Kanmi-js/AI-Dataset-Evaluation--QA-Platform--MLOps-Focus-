# Copy to .env and adjust:  cp .env.example .env
#
# Read by two consumers:
#   1. Docker Compose, for ${...} interpolation in docker-compose.yml
#   2. The backend + worker containers, via `env_file:`
#
# The defaults below match docker-compose.yml, so an untouched copy boots a
# working local stack. Change SECRET_KEY and INTERNAL_API_TOKEN before any
# deployment — the app refuses to start in production while they are unset.

# --- General ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Adds X-Tunnel-Skip-Anti-Phishing-Page to every response, so VS Code devtunnels
# / ngrok-style proxies stop interposing their interstitial page on API calls.
# A workaround for one local setup, off by default. It does not touch CORS —
# CORS_ORIGINS above is the only thing that decides who may call the API.
ENABLE_TUNNEL_HEADERS=false

# --- Upload limits (bytes) ---
# Two caps because a clip is an order of magnitude larger than a still. The
# upload route buffers each file in memory before handing it to S3, so raising
# the video cap raises peak API memory with it — see "Known limits" in README.md.
#
# Keep values bare: Compose's env_file parser does not strip inline comments, so
# `MAX_UPLOAD_BYTES=123  # note` would be read as the literal string with the
# comment attached, and the container would fail to start.
# 25 MB — images, text
MAX_UPLOAD_BYTES=26214400
# 200 MB — match clips
MAX_VIDEO_UPLOAD_BYTES=209715200

# --- PostgreSQL ---
# These three configure the `db` container itself.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_password
POSTGRES_DB=mlops_qa

# ...and these are how the app reaches it. Two DSNs for the same database:
# asyncpg for the FastAPI request path, psycopg2 for Celery and Alembic.
# Hostname `db` is the Compose service name; use localhost to run outside Docker.
DATABASE_URL=postgresql+asyncpg://mlops:mlops_password@db:5432/mlops_qa
DATABASE_URL_SYNC=postgresql+psycopg2://mlops:mlops_password@db:5432/mlops_qa

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Object storage (MinIO locally, S3 in AWS) ---
# Internal endpoint used by backend + worker (container-to-container).
S3_ENDPOINT_URL=http://minio:9000
# Endpoint used ONLY when signing URLs for the browser. SigV4 signs the Host
# header, so a URL signed against `minio:9000` fails in the browser, which
# cannot resolve that name. In AWS, leave both unset to use real S3.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datasets
S3_REGION=us-east-1

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Shared secret the S3-event Lambda presents on /api/v1/internal/* routes.
INTERNAL_API_TOKEN=change-me-in-production

# --- Video analysis ---
# "yolo" tracks the real footage; "simulated" is the placeholder used by tests.
TRACKER=yolo
ANALYSIS_FPS=10
MAX_ANALYSIS_SECONDS=90

# --- Tactical breakdowns ---
# Both optional. Without ANTHROPIC_API_KEY the script is a template built from
# the detected events; without ELEVENLABS_API_KEY the clip has captions only.
ANTHROPIC_API_KEY=
COMMENTARY_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs library. Never clone a real person's voice
# without their consent.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
