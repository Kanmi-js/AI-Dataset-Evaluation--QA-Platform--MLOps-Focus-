# Copy to terraform.tfvars and edit. Every value below has a default in
# variables.tf, so an empty file also works — these are the ones worth a
# deliberate decision.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region  = "us-east-1"
project     = "mlops-qa"
environment = "prod"

# --- Access ---
#
# The ALB is public by default because this is a demo dashboard. If the
# deployment is internal, narrow this to your office or VPN range — it is the
# single most useful change in this file.
allowed_http_cidrs = ["0.0.0.0/0"]
# allowed_http_cidrs = ["203.0.113.0/24"]

# --- Sizing ---
#
# t3.small (2 GB) runs FastAPI + Celery + Redis + nginx with little headroom.
# Move to t3.medium if the worker is OOM-killed on large images.
instance_type    = "t3.small"
root_volume_size = 30

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20

# --- Database ---

db_name     = "mlops_qa"
db_username = "mlops"

# The password is generated by Terraform and stored in SSM; it never appears in
# this file or in plan output. Read it with the db_password_command output.

db_backup_retention_days = 7

# Leave true for anything you care about. Set false *before* running
# `terraform destroy` on a throwaway environment, and apply that change first —
# destroy fails while protection is on.
db_deletion_protection = true

# --- CI/CD ---
#
# Set this to enable the GitHub OIDC deploy role; leave empty to deploy by hand.
# Feed the resulting github_deploy_role_arn output to the repository's
# AWS_DEPLOY_ROLE_ARN secret.
github_repo = ""
# github_repo = "your-org/mlops-qa-platform"

# AWS allows exactly one GitHub OIDC provider per account. If another stack in
# this account already created it, set this to false and the deploy role will
# reference the existing provider instead of failing with EntityAlreadyExists.
create_github_oidc_provider = true

# --- Images ---
#
# Only the initial boot value. CD replaces the running stack with the commit
# SHA, so this stays "latest" in normal operation.
image_tag = "latest"
