# RDS PostgreSQL + the generated credentials.
#
# Passwords are generated by Terraform and written to SSM Parameter Store as
# SecureStrings. They are never placed in Terraform output, never in user-data
# (which is readable from instance metadata), and never in this repository — the
# instance reads them at boot with its IAM role.

resource "random_password" "db" {
  length = 32
  # RDS rejects /, ", @, and spaces in the master password.
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

resource "aws_db_subnet_group" "main" {
  name       = "${local.name_prefix}-db"
  subnet_ids = aws_subnet.private[*].id

  tags = { Name = "${local.name_prefix}-db" }
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name_prefix}-pg16"
  family = "postgres16"

  # Every request hits the health endpoint, which runs `SELECT 1`. At debug
  # level those would land in the RDS log and cost storage for nothing.
  parameter {
    name  = "log_statement"
    value = "none"
  }

  tags = { Name = "${local.name_prefix}-pg16" }
}

resource "aws_db_instance" "main" {
  identifier = "${local.name_prefix}-db"

  engine         = "postgres"
  engine_version = "16"
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_allocated_storage * 2
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = 5432

  db_subnet_group_name   = aws_db_subnet_group.main.name
  parameter_group_name   = aws_db_parameter_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]

  # Single-AZ: this is a demo topology. Flip to true (and add a standby) before
  # it holds anything you cannot re-create.
  multi_az = false

  backup_retention_period = var.db_backup_retention_days
  backup_window           = "03:00-04:00"
  maintenance_window      = "sun:04:30-sun:05:30"

  auto_minor_version_upgrade = true
  apply_immediately          = false

  deletion_protection       = var.db_deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.name_prefix}-db-final"

  # No NAT route means the instance cannot reach the RDS-managed OS patch
  # service on its own; minor version upgrades still apply at the maintenance
  # window.
  performance_insights_enabled = false

  tags = { Name = "${local.name_prefix}-db" }
}

# --- Parameter Store ---
#
# Connection *components*, not assembled DSNs. The password is generated with
# symbols that must be percent-encoded inside a URL (a literal "#" ends the URL
# at the fragment), and Terraform has no built-in urlencode. Doing the encoding
# in the boot script with Python's urllib.parse is correct by construction and
# keeps this file readable.
#
# One path per value so IAM can be scoped per-prefix and the instance can pull
# them all with a single get-parameters-by-path call.

locals {
  ssm_params = {
    DB_HOST     = aws_db_instance.main.address
    DB_PORT     = tostring(aws_db_instance.main.port)
    DB_NAME     = var.db_name
    DB_USER     = var.db_username
    DB_PASSWORD = random_password.db.result
  }
}

resource "aws_ssm_parameter" "db" {
  for_each = local.ssm_params

  name        = "/${local.name_prefix}/${each.key}"
  description = "Database connection setting ${each.key}"
  type        = "SecureString"
  value       = each.value

  tags = { Name = "${local.name_prefix}-${each.key}" }
}
